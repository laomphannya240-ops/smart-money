# ---------------------------------------------------------------------------
# Smart Money — single-owner demo configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and replace the values with your own.
# `.env` is git-ignored; never commit real credentials.
#
# Only this exact Gmail address can sign in. Registration is not supported.
VITE_OWNER_EMAIL=laomphannya240@gmail.com

# SHA-256 hex digest (64 characters) of your password — NOT the password itself.
# Generate one with:  npm run hash:password
# Example: the hash below is SHA-256 of "DemoPass123!"
VITE_OWNER_PASSWORD_HASH=laomphannya240
